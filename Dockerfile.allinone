FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        make \
        libreadline-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /lissandra

COPY . .

RUN make

RUN chmod +x docker/allinone/start.sh

# El escenario se elige con la variable SCENARIO (default: base)
ENV SCENARIO=base

ENTRYPOINT ["/lissandra/docker/allinone/start.sh"]
