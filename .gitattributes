# Forzar LF en todos los archivos de texto del repo
* text=auto eol=lf

# Explicitamente LF para scripts y configs
*.sh    text eol=lf
*.cfg   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
.env    text eol=lf

# Binarios — sin conversión
*.bin   binary
*.o     binary
*.so    binary
